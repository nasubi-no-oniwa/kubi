{
  "run": {
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid && newData.exists()",
      ".validate": "newData.hasChildren([\"st\"]) && newData.child(\"st\").val() === now",
      "st": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    }
  },
  "b": {
    "all": {
      ".read": true,
      ".indexOn": [
        "sk"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists() && !root.child(\"kubi/ban/\" + $uid).exists() && newData.child(\"st\").val() === root.child(\"kubi/run/\" + $uid).child(\"st\").val() && now - newData.child(\"st\").val() >= 1500 && now - newData.child(\"st\").val() <= 14400000 && (!data.exists() || newData.child(\"sk\").val() < data.child(\"sk\").val())",
        ".validate": "newData.hasChildren([\"n\", \"t\", \"sk\", \"st\", \"v\", \"at\"])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 15000 && newData.val() % 1 === 0"
        },
        "sk": {
          ".validate": "newData.val() === newData.parent().child(\"t\").val()"
        },
        "st": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.val() === 1"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "d": {
      ".read": true,
      ".indexOn": [
        "ds"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists() && !root.child(\"kubi/ban/\" + $uid).exists() && newData.child(\"st\").val() === root.child(\"kubi/run/\" + $uid).child(\"st\").val() && now - newData.child(\"st\").val() >= 1500 && now - newData.child(\"st\").val() <= 14400000 && (!data.exists() || newData.child(\"dk\").val() > data.child(\"dk\").val() || (newData.child(\"dk\").val() === data.child(\"dk\").val() && newData.child(\"sk\").val() < data.child(\"sk\").val()))",
        ".validate": "newData.hasChildren([\"n\", \"t\", \"sk\", \"st\", \"v\", \"at\", \"dk\", \"ds\"])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 15000 && newData.val() % 1 === 0"
        },
        "sk": {
          ".validate": "newData.val() === newData.parent().child(\"t\").val()"
        },
        "st": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.val() === 1"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "dk": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= (now + 32400000) / 86400000 - 1.01 && newData.val() <= (now + 32400000) / 86400000 + 0.01"
        },
        "ds": {
          ".validate": "newData.val() === newData.parent().child(\"dk\").val() * 100000 + newData.parent().child(\"sk\").val()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}